# Copy this file to .env (gitignored) and fill in real values.

# ESPN has no OAuth -- these are two cookie values copied from a browser
# session logged into fantasy.espn.com (only needed for a private league;
# public leagues need neither):
#   1. Log into fantasy.espn.com
#   2. Chrome DevTools (Cmd+Option+I) > Application tab > Storage > Cookies
#      > https://fantasy.espn.com
#   3. Copy the "espn_s2" and "SWID" row values (SWID includes its {braces})
# These are just long-lived session cookies, not a token that auto-refreshes
# -- if ESPN calls start 401ing, re-extract them the same way.
ESPN_S2=
ESPN_SWID=
